# =============================================================================
# loop.conf — 迴圈設定（複製為 loop.conf 後填寫）
# 這份檔案是受保護檔案，AI 不得修改。
# =============================================================================

# ── 專案識別 ────────────────────────────────────────────────
PROJECT_NAME="my-netops-tool"     # 同時也是 systemd service 名稱
SERVICE_PORT="8080"

# ── 迴圈邊界 ────────────────────────────────────────────────
# 對應 CLAUDE.md 的「死迴圈自我防護規則」，但這裡是機械強制的，
# 不依賴 AI 自己遵守 prompt 裡的約定。
MAX_ATTEMPTS=3                    # 嘗試上限，超過就停止呼叫人工
TIMEOUT_SEC=900                   # 單次執行逾時（秒）

# ── Agent 呼叫方式 ──────────────────────────────────────────
# Claude Code 的 print mode；換成其他 harness 也只要改這一行。
AGENT_CMD="claude -p"
# 其他選項：
# AGENT_CMD="pi -p"                       # Pi agent
# AGENT_CMD="claude -p --model opus"      # 指定模型

# ── 受保護路徑 ──────────────────────────────────────────────
# 迴圈偵測到這些路徑被動過，立即硬性退出。
PROTECTED_PATHS="docs/ prompts/ .env DONE.md loop.conf verify.sh loop.sh"
